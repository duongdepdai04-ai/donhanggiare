<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Đồ Tốt Giá Rẻ Đã Có</title>
<style>
:root{--orange:#ee6b2f;--orange2:#ff8a45;--ink:#202124;--muted:#747474;--line:#eee7e2;--bg:#fffaf7}
*{box-sizing:border-box}body{margin:0;font-family:Arial,Helvetica,sans-serif;color:var(--ink);background:var(--bg)}
header{height:68px;background:white;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 max(20px,calc((100% - 1180px)/2));position:sticky;top:0;z-index:5}
.brand{font-size:21px;font-weight:800}.brand span{color:var(--orange)}
.plus{width:42px;height:42px;border:0;border-radius:50%;background:var(--orange);color:white;font-size:28px;cursor:pointer;box-shadow:0 5px 14px #ee6b2f33}
main{max-width:1180px;margin:auto;padding:35px 20px 70px}.hero{display:flex;justify-content:space-between;align-items:center;gap:20px}.hero h1{font-size:clamp(32px,5vw,48px);line-height:1.13;margin:10px 0 15px;letter-spacing:-1.5px}.hero h1 span{color:var(--orange)}.hero p{color:var(--muted);line-height:1.65;max-width:690px;margin:0}.hero-mark{font-size:70px;color:#ffdfca;flex-shrink:0;margin-right:8%}
.tools{margin-top:30px;display:flex;flex-wrap:wrap;gap:10px}.chip{border:1px solid var(--line);background:white;border-radius:24px;padding:11px 16px;cursor:pointer;font-weight:600;color:#333}.chip.active,.chip:hover{background:var(--orange);border-color:var(--orange);color:white}
.search{margin-top:14px;width:min(100%,360px);border:1px solid var(--line);border-radius:25px;background:white;padding:13px 17px;font-size:15px;outline:none}.search:focus,input:focus,textarea:focus,select:focus{border-color:var(--orange);outline:2px solid #ee6b2f20}
.count{color:var(--muted);font-size:13px;margin:22px 0 14px}.products{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:17px}.product{background:white;border:1px solid var(--line);border-radius:16px;overflow:hidden;cursor:pointer;transition:.18s}.product:hover{transform:translateY(-3px);box-shadow:0 10px 28px #41200e0d}.thumb{height:190px;background:#f8eee7;display:flex;align-items:center;justify-content:center;overflow:hidden;color:#c5a28d;font-size:14px}.thumb img{width:100%;height:100%;object-fit:cover}.pbody{padding:14px}.ptitle{font-weight:700;line-height:1.4;min-height:40px;overflow-wrap:anywhere}.price{font-size:20px;font-weight:800;color:var(--orange);margin:9px 0}.small{font-size:12px;color:var(--muted)}.stars{color:#f2a900;letter-spacing:1px}.empty{padding:65px 12px;text-align:center;color:var(--muted);grid-column:1/-1}
.overlay{position:fixed;inset:0;background:#17120f88;z-index:10;display:none;align-items:center;justify-content:center;padding:16px;overflow:auto}.overlay.show{display:flex}.modal{background:white;border-radius:18px;width:min(620px,100%);max-height:92vh;overflow:auto;padding:22px;position:relative}.modal.wide{width:min(850px,100%)}.close{position:absolute;right:13px;top:11px;border:0;background:#f6f2ef;border-radius:50%;width:34px;height:34px;font-size:20px;cursor:pointer}.modal h2{margin:2px 42px 18px 0}.field{display:block;margin:14px 0}.field label{display:block;font-size:13px;font-weight:700;margin-bottom:7px}.field input,.field textarea,.field select{width:100%;border:1px solid #e5ddd7;border-radius:10px;padding:12px;font:inherit;background:white}.field textarea{min-height:100px;resize:vertical}.btn{border:0;border-radius:10px;padding:12px 17px;background:var(--orange);color:white;font-weight:700;cursor:pointer}.btn.secondary{background:#f5eee9;color:#533b2c}.btn:disabled{opacity:.5}.hint{font-size:12px;color:var(--muted);line-height:1.5}.form-actions{display:flex;gap:9px;justify-content:flex-end;margin-top:18px}.detail-grid{display:grid;grid-template-columns: minmax(0,1fr) minmax(0,1fr);gap:22px}.detail-image{background:#f8eee7;border-radius:13px;min-height:230px;display:flex;align-items:center;justify-content:center;overflow:hidden}.detail-image img{width:100%;max-height:360px;object-fit:contain}.detail-image .thumb{height:100%;min-height:230px;width:100%}.detail-title{font-size:25px;font-weight:800;line-height:1.25}.detail-price{font-size:28px;color:var(--orange);font-weight:800;margin:12px 0}.comments{border-top:1px solid var(--line);margin-top:22px;padding-top:17px}.comment{display:flex;gap:10px;padding:13px 0;border-bottom:1px solid #f2eeeb}.avatar{width:35px;height:35px;flex-shrink:0;border-radius:50%;background:#f1f1f1;display:flex;align-items:center;justify-content:center;color:#999}.comment-main{min-width:0;flex:1}.comment-head{display:flex;gap:8px;flex-wrap:wrap;align-items:center;font-size:13px}.comment-text{margin-top:6px;white-space:pre-wrap;overflow-wrap:anywhere}.review-form{background:#fff8f3;padding:14px;border-radius:12px;margin-top:14px}.rating-pick{font-size:25px;color:#ddd;cursor:pointer;letter-spacing:2px}.rating-pick span.on{color:#f2a900}.notice{padding:10px 12px;background:#fff2e9;border-radius:9px;color:#7b4a2d;font-size:12px;line-height:1.5;margin:12px 0}
.action-choice{display:flex;gap:10px;margin:18px 0 4px}.action-choice .btn{flex:1}.btn.danger{background:#d93636}.product{user-select:none;-webkit-user-select:none;touch-action:pan-y}
@media(max-width:850px){.products{grid-template-columns:repeat(3,minmax(0,1fr))}.thumb{height:160px}.hero-mark{margin-right:0}}
@media(max-width:600px){header{height:60px;padding:0 16px}.brand{font-size:18px}main{padding:25px 14px 50px}.hero-mark{display:none}.products{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.thumb{height:145px}.pbody{padding:11px}.ptitle{font-size:14px}.price{font-size:17px}.chip{padding:9px 12px;font-size:13px}.detail-grid{grid-template-columns:1fr}.detail-image{min-height:190px}.modal{padding:18px}.hero h1{font-size:34px}}
</style>
</head>
<body>
<header><div class="brand">Đồ Tốt <span>Giá Rẻ Đã Có</span></div><button class="plus" title="Mở trang quản trị" aria-label="Mở trang quản trị" onclick="openAdminGate()">+</button></header>
<main>
<section class="hero"><div><h1>Đồ Tốt, <span>Giá Rẻ</span><br>Đã Có</h1><p>Những món đồ được chọn lọc trên Shopee. Bấm vào sản phẩm để xem mô tả đầy đủ, đánh giá và link mua hàng.</p></div><div class="hero-mark">✦</div></section>
<div class="tools" id="categories"></div><input class="search" id="search" placeholder="Tìm sản phẩm..." autocomplete="off"><div class="count" id="count"></div><section class="products" id="products"></section>
</main>
<div class="overlay" id="gate"><div class="modal"><button class="close" onclick="closeModal('gate')">×</button><h2>Truy cập Admin</h2><p class="hint">Nhập mã quản trị để thêm hoặc quản lý sản phẩm.</p><form id="gateForm"><div class="field"><label>Mã admin</label><input id="adminCode" type="password" placeholder="Nhập mã truy cập" required></div><div id="gateError" class="hint"></div><div class="form-actions"><button type="button" class="btn secondary" onclick="closeModal('gate')">Huỷ</button><button class="btn">Truy cập</button></div></form></div></div>
<div class="overlay" id="admin"><div class="modal"><button class="close" onclick="closeModal('admin')">×</button><h2>Quản lý sản phẩm</h2><p class="hint">Thêm sản phẩm mới hoặc xoá sản phẩm đã đăng.</p><button class="btn" onclick="openProductForm()">＋ Thêm sản phẩm</button><div id="adminProducts"></div><p class="hint">Lưu ý: bản này lưu trên trình duyệt đang mở, chưa đồng bộ lên mạng cho người khác.</p></div></div>
<div class="overlay" id="productForm"><div class="modal"><button class="close" onclick="closeModal('productForm')">×</button><h2>Thêm sản phẩm</h2><form id="addForm">
<div class="field"><label>Ảnh sản phẩm</label><input id="imageFile" type="file" accept="image/*"><div class="hint">Chọn ảnh từ máy/điện thoại (ảnh sẽ lưu trong trình duyệt này).</div><div id="imagePreview"></div></div>
<div class="field"><label>Tên sản phẩm *</label><input id="pName" maxlength="120" required placeholder="Ví dụ: Tai nghe Bluetooth"></div>
<div class="field"><label>Mô tả sản phẩm *</label><textarea id="pDesc" maxlength="3000" required placeholder="Mô tả chi tiết sản phẩm..."></textarea></div>
<div class="field"><label>Link mua hàng *</label><input id="pLink" type="url" required placeholder="https://..."></div>
<div class="field"><label>Giá tiền (VNĐ) *</label><input id="pPrice" type="number" min="0" step="1000" required placeholder="99000"></div>
<div class="field"><label>Loại hàng *</label><select id="pCategory" required><option value="Thời trang">👗 Thời trang</option><option value="Mỹ phẩm">💄 Mỹ phẩm</option><option value="Gia dụng">🏠 Gia dụng</option><option value="Công nghệ">🧮 Công nghệ</option><option value="Giải trí">🎮 Giải trí</option></select></div>
<div class="form-actions"><button type="button" class="btn secondary" onclick="closeModal('productForm')">Huỷ</button><button class="btn">Đăng sản phẩm</button></div></form></div></div>
<div class="overlay" id="detail"><div class="modal wide"><button class="close" onclick="closeModal('detail')">×</button><div id="detailContent"></div></div></div>
<div class="overlay" id="productActions"><div class="modal"><button class="close" onclick="closeModal('productActions')">×</button><h2>Tùy chọn sản phẩm</h2><p class="hint" id="actionProductName"></p><div class="action-choice"><button class="btn secondary" onclick="openSelectedDetails()">Thông tin chi tiết</button><button class="btn danger" onclick="askDeletePassword()">Xóa sản phẩm</button></div><p class="hint">Điện thoại: nhấn giữ sản phẩm. Máy tính: nhấp chuột phải.</p></div></div>
<div class="overlay" id="deletePassword"><div class="modal"><button class="close" onclick="closeModal('deletePassword')">×</button><h2>Xác nhận xóa sản phẩm</h2><p class="hint">Nhập mật mã admin để xóa sản phẩm này.</p><form id="deleteForm"><div class="field"><label>Mật mã admin</label><input id="deleteCode" type="password" required placeholder="Nhập mật mã"></div><div class="hint" id="deleteError"></div><div class="form-actions"><button type="button" class="btn secondary" onclick="closeModal('deletePassword')">Hủy</button><button class="btn danger">Xác nhận xóa</button></div></form></div></div>
<script>
const ADMIN_CODE='Admin 01';
const CATEGORIES=[['Tất cả','✨'],['Thời trang','👗'],['Mỹ phẩm','💄'],['Gia dụng','🏠'],['Công nghệ','🧮'],['Giải trí','🎮']];
const STORE_KEY='doTotGiaRe_products_v1', REVIEW_KEY='doTotGiaRe_reviews_v1', VISITOR_KEY='doTotGiaRe_visitor_v1';
let activeCategory='Tất cả', currentImage='', currentProductId=null, pickedRating=5;
const $=id=>document.getElementById(id);
function read(key,fallback){try{return JSON.parse(localStorage.getItem(key))??fallback}catch{return fallback}}
function save(key,value){try{localStorage.setItem(key,JSON.stringify(value));return true}catch(e){alert('Bộ nhớ trình duyệt đã đầy. Hãy dùng ảnh nhỏ hơn.');return false}}
function products(){return read(STORE_KEY,[])}
function reviews(){return read(REVIEW_KEY,{})}
function money(n){return Number(n||0).toLocaleString('vi-VN')+' ₫'}
function safe(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function openModal(id){$(id).classList.add('show')}function closeModal(id){$(id).classList.remove('show')}
document.querySelectorAll('.overlay').forEach(o=>o.addEventListener('click',e=>{if(e.target===o)o.classList.remove('show')}));
function renderCategories(){ $('categories').innerHTML=CATEGORIES.map(([name,emoji])=>`<button class="chip ${activeCategory===name?'active':''}" onclick="setCategory('${name}')">${emoji} ${name} <span>${name==='Tất cả'?products().length:products().filter(p=>p.category===name).length}</span></button>`).join('')}
function avgRating(id){const list=reviews()[id]||[];return list.length?list.reduce((a,r)=>a+r.rating,0)/list.length:0}
function render(){renderCategories();let q=$('search').value.trim().toLocaleLowerCase('vi');let list=products().filter(p=>(activeCategory==='Tất cả'||p.category===activeCategory)&&(`${p.name} ${p.desc} ${p.category}`).toLocaleLowerCase('vi').includes(q));$('count').textContent=`${list.length} sản phẩm`; $('products').innerHTML=list.length?list.map(p=>{let r=reviews()[p.id]||[],avg=avgRating(p.id);return `<article class="product" data-product-id="${p.id}" onclick="productCardClick('${p.id}')" oncontextmenu="event.preventDefault();openProductActions('${p.id}')"><div class="thumb">${p.image?`<img src="${p.image}" alt="${safe(p.name)}">`:'Ảnh sản phẩm'}</div><div class="pbody"><div class="ptitle">${safe(p.name)}</div><div class="price">${money(p.price)}</div><div class="small">${safe(p.category)}</div><div class="small"><span class="stars">${avg?'★'.repeat(Math.round(avg))+'☆'.repeat(5-Math.round(avg)):'☆☆☆☆☆'}</span> ${avg?avg.toFixed(1):'Chưa có'} · ${r.length} đánh giá</div></div></article>`}).join(''):'<div class="empty">Chưa có sản phẩm nào.<br><span class="hint">Bấm dấu + ở góc trên để vào trang quản trị và đăng sản phẩm đầu tiên.</span></div>'}
let selectedProductId=null, longPressTimer=null, suppressCardClick=false;
function productCardClick(id){if(suppressCardClick){suppressCardClick=false;return}showDetail(id)}
function openProductActions(id){selectedProductId=id;let p=products().find(x=>x.id===id);if(!p)return;$('actionProductName').textContent=p.name;openModal('productActions')}
function openSelectedDetails(){let id=selectedProductId;closeModal('productActions');if(id)showDetail(id)}
function askDeletePassword(){$('deleteCode').value='';$('deleteError').textContent='';closeModal('productActions');openModal('deletePassword')}
$('deleteForm').addEventListener('submit',e=>{e.preventDefault();if($('deleteCode').value!==ADMIN_CODE){$('deleteError').textContent='Mật mã không đúng. Sản phẩm chưa bị xóa.';return}if(!selectedProductId){closeModal('deletePassword');return}if(!confirm('Bạn chắc chắn muốn xóa sản phẩm này?'))return;let id=selectedProductId;save(STORE_KEY,products().filter(p=>p.id!==id));let all=reviews();delete all[id];save(REVIEW_KEY,all);selectedProductId=null;closeModal('deletePassword');closeModal('detail');render();alert('Đã xóa sản phẩm.')});
document.addEventListener('pointerdown',e=>{let card=e.target.closest('.product');if(!card||e.pointerType==='mouse')return;let id=card.dataset.productId;clearTimeout(longPressTimer);longPressTimer=setTimeout(()=>{suppressCardClick=true;openProductActions(id)},600)});
document.addEventListener('pointerup',()=>clearTimeout(longPressTimer));document.addEventListener('pointercancel',()=>clearTimeout(longPressTimer));document.addEventListener('scroll',()=>clearTimeout(longPressTimer),true);
function setCategory(name){activeCategory=name;render()}
$('search').addEventListener('input',render);
function openAdminGate(){$('adminCode').value='';$('gateError').textContent='';openModal('gate')}
$('gateForm').addEventListener('submit',e=>{e.preventDefault();if($('adminCode').value===ADMIN_CODE){closeModal('gate');renderAdmin();openModal('admin')}else $('gateError').textContent='Mã không đúng, thử lại nhé.'});
function renderAdmin(){let list=products();$('adminProducts').innerHTML=list.length?'<h3>Đã đăng</h3>'+list.map(p=>`<div style="display:flex;gap:10px;align-items:center;border-bottom:1px solid #eee;padding:10px 0"><div style="flex:1"><b>${safe(p.name)}</b><div class="small">${money(p.price)} · ${safe(p.category)}</div></div><button class="btn secondary" onclick="deleteProduct('${p.id}')">Xoá</button></div>`).join(''):'<p class="hint">Chưa có sản phẩm.</p>'}
function deleteProduct(id){if(!confirm('Xoá sản phẩm này?'))return;save(STORE_KEY,products().filter(p=>p.id!==id));let r=reviews();delete r[id];save(REVIEW_KEY,r);render();renderAdmin()}
function openProductForm(){currentImage='';$('imageFile').value='';$('imagePreview').innerHTML='';$('addForm').reset();openModal('productForm')}
$('imageFile').addEventListener('change',e=>{let f=e.target.files[0];if(!f)return;if(!f.type.startsWith('image/')){alert('Hãy chọn tệp ảnh.');return}if(f.size>1.5*1024*1024){alert('Ảnh hơi lớn. Hãy chọn ảnh dưới 1,5 MB để lưu được.');e.target.value='';return}let reader=new FileReader();reader.onload=()=>{currentImage=reader.result;$('imagePreview').innerHTML=`<img src="${currentImage}" style="max-width:120px;max-height:120px;object-fit:contain;margin-top:8px;border-radius:8px">`};reader.readAsDataURL(f)});
$('addForm').addEventListener('submit',e=>{e.preventDefault();let link=$('pLink').value.trim();try{let u=new URL(link);if(!['http:','https:'].includes(u.protocol))throw 0}catch{alert('Link mua hàng phải bắt đầu bằng https:// hoặc http://');return}
let p={id:Date.now().toString(36)+Math.random().toString(36).slice(2,7),name:$('pName').value.trim(),desc:$('pDesc').value.trim(),link,price:Number($('pPrice').value),category:$('pCategory').value,image:currentImage,createdAt:Date.now()};
let list=products();list.unshift(p);if(!save(STORE_KEY,list))return;closeModal('productForm');render();renderAdmin();alert('Đã đăng sản phẩm trên trình duyệt này!')});
function showDetail(id){let p=products().find(x=>x.id===id);if(!p)return;currentProductId=id;let list=reviews()[id]||[],avg=avgRating(id);$('detailContent').innerHTML=`<div class="detail-grid"><div class="detail-image">${p.image?`<img src="${p.image}" alt="${safe(p.name)}">`:'<div class="thumb">Ảnh sản phẩm</div>'}</div><div><div class="small">${safe(p.category)}</div><div class="detail-title">${safe(p.name)}</div><div class="detail-price">${money(p.price)}</div><div><span class="stars">${avg?'★'.repeat(Math.round(avg))+'☆'.repeat(5-Math.round(avg)):'☆☆☆☆☆'}</span> ${avg?avg.toFixed(1):'Chưa có đánh giá'} (${list.length})</div><p style="white-space:pre-wrap;line-height:1.6">${safe(p.desc)}</p><a class="btn" style="display:inline-block;text-decoration:none" href="${safe(p.link)}" target="_blank" rel="noopener noreferrer">Mở link mua hàng ↗</a></div></div><section class="comments"><h3>Đánh giá & bình luận (${list.length})</h3><p class="hint">Mỗi trình duyệt chỉ gửi được một đánh giá cho mỗi sản phẩm trong bản demo này.</p><div id="commentList">${renderCommentHtml(list)}</div><div id="reviewArea"></div></section>`;renderReviewForm(id);openModal('detail')}
function renderCommentHtml(list){return list.length?list.map((r,i)=>`<div class="comment"><div class="avatar">●</div><div class="comment-main"><div class="comment-head"><b>Người dùng ${i+1}</b><span class="stars">${'★'.repeat(r.rating)}${'☆'.repeat(5-r.rating)}</span></div><div class="comment-text">${safe(r.text||'Đã đánh giá sản phẩm')}</div></div></div>`).join(''):'<p class="hint">Chưa có đánh giá. Hãy là người đầu tiên nhé!</p>'}
function renderReviewForm(id){let visitor=localStorage.getItem(VISITOR_KEY);let already=(reviews()[id]||[]).some(r=>r.visitor===visitor);if(already){$('reviewArea').innerHTML='<div class="notice">Bạn đã gửi đánh giá cho sản phẩm này trên trình duyệt này rồi.</div>';return}pickedRating=5;$('reviewArea').innerHTML=`<div class="review-form"><b>Đánh giá của bạn</b><div class="rating-pick" id="ratingPick">${[1,2,3,4,5].map(n=>`<span class="${n<=5?'on':''}" data-rating="${n}">★</span>`).join('')}</div><textarea id="reviewText" maxlength="1000" placeholder="Chia sẻ cảm nhận của bạn..." style="width:100%;min-height:75px;border:1px solid #e5ddd7;border-radius:10px;padding:10px;font:inherit;margin:8px 0"></textarea><button class="btn" onclick="submitReview('${id}')">Gửi đánh giá</button></div>`;$('ratingPick').querySelectorAll('span').forEach(s=>s.onclick=()=>{pickedRating=Number(s.dataset.rating);$('ratingPick').querySelectorAll('span').forEach(x=>x.classList.toggle('on',Number(x.dataset.rating)<=pickedRating))})}
function submitReview(id){let visitor=localStorage.getItem(VISITOR_KEY);let all=reviews(),list=all[id]||[];if(list.some(r=>r.visitor===visitor)){alert('Bạn đã đánh giá sản phẩm này rồi.');return}list.push({visitor,rating:pickedRating,text:$('reviewText').value.trim(),createdAt:Date.now()});all[id]=list;if(!save(REVIEW_KEY,all))return;showDetail(id);render()}
if(!localStorage.getItem(VISITOR_KEY)){try{localStorage.setItem(VISITOR_KEY,'u'+Math.random().toString(36).slice(2)+Date.now().toString(36))}catch{}}
render();
</script>
</body>
</html>